#!/usr/bin/python3 -EsB
"""Manage the standalone full-profile secrets repository.

Commands:
  init    seed a complete default profile and wait for the operator to fill it
  import  copy the whole profile into the protected config store
  status  report profile presence and placeholder state (no secret values)
  set     set one dotted key (prompts without echo when VALUE is omitted)
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import secrets_store


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="Manage the private secrets profile repository")
    parser.add_argument("command", choices=("init", "import", "status", "set"))
    parser.add_argument("key", nargs="?")
    parser.add_argument("value", nargs="?")
    parser.add_argument("--root", default=str(Path(__file__).resolve().parents[1]),
        help="installation or source root containing the secrets/ repository")
    parser.add_argument("--yes", action="store_true",
        help="accept the seeded defaults without waiting for confirmation")
    parser.add_argument("--json", action="store_true", help="emit JSON")
    args = parser.parse_intermixed_args(argv)
    try:
        if args.command == "init":
            result = secrets_store.init(args.root, assume_yes=args.yes)
        elif args.command == "import":
            result = secrets_store.import_secrets(args.root)
        elif args.command == "set":
            if not args.key:
                raise secrets_store.InstallError("set requires a dotted KEY")
            value = args.value
            if value is None:
                import getpass
                value = getpass.getpass(args.key + ": ")
            result = secrets_store.set_value(args.root, args.key, value)
        else:
            result = secrets_store.status(args.root)
    except secrets_store.InstallError as error:
        print("ERROR: " + str(error), file=sys.stderr)
        return 1
    except OSError:
        print("ERROR: secrets repository is unavailable", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
