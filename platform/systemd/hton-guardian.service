[Unit]
Description=HTON independent activation guardian
Documentation=file:/opt/hton/docs/CLI.md
Wants=docker.service
After=local-fs.target docker.service
ConditionPathIsExecutable=/opt/hton/libexec/hton-runtime
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/hton
UMask=0077
RuntimeDirectory=hton
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/hton/libexec/hton-runtime guardian --state-root /opt/hton/work/runtime --bundle-root /opt/hton/work/bundles --authority-root /opt/hton/work/runtime/authorities
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=full
ReadOnlyPaths=/opt/hton
ReadWritePaths=/opt/hton/work /run/hton
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
