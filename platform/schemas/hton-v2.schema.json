{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "instance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "properties": {
        "systemd": {
          "type": "boolean"
        },
        "pathShim": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "core": {
      "type": "object",
      "properties": {
        "edge": {
          "type": "object",
          "properties": {
            "listen": {
              "type": "object",
              "properties": {
                "transport": {
                  "const": "tcp"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "scope": {
                  "enum": [
                    "public",
                    "host-loopback",
                    "project"
                  ]
                },
                "addressFamilies": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "ipv4",
                      "ipv6"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "transport",
                "port",
                "addressFamilies"
              ],
              "additionalProperties": false
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "hostPolicy": {
              "type": "object",
              "properties": {
                "wildcardZone": {
                  "type": "string",
                  "minLength": 1
                },
                "redirectTarget": {
                  "type": "string",
                  "pattern": "^https://[^/]+/$"
                },
                "unknown": {
                  "const": "reject"
                }
              },
              "required": [
                "wildcardZone",
                "redirectTarget",
                "unknown"
              ],
              "additionalProperties": false
            },
            "testTunnel": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "sni": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              },
              "required": [
                "sni",
                "port"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "listen",
            "domains"
          ],
          "additionalProperties": false
        },
        "certificates": {
          "type": "object",
          "properties": {
            "ca": {
              "const": "letsencrypt"
            },
            "challenge": {
              "const": "dns-01"
            },
            "provider": {
              "const": "internetbs"
            },
            "email": {
              "type": "string",
              "minLength": 1
            },
            "wildcardDomain": {
              "type": "string",
              "minLength": 1
            },
            "credentials": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "type": "object",
                  "properties": {
                    "secretRef": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
                    }
                  },
                  "required": [
                    "secretRef"
                  ],
                  "additionalProperties": false
                },
                "apiPassword": {
                  "type": "object",
                  "properties": {
                    "secretRef": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
                    }
                  },
                  "required": [
                    "secretRef"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "apiKey",
                "apiPassword"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ca",
            "challenge",
            "provider",
            "email",
            "credentials"
          ],
          "additionalProperties": false
        },
        "dns": {
          "type": "object",
          "properties": {
            "upstreamMode": {
              "enum": [
                "tls-forward",
                "recursive"
              ]
            },
            "upstreams": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "addresses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "ipv4"
                    },
                    "minItems": 1
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "tlsName": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "addresses",
                  "port",
                  "tlsName"
                ],
                "additionalProperties": false
              }
            },
            "upstreamOrder": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "fallback": {
              "const": "fail-closed"
            }
          },
          "required": [
            "upstreamMode"
          ],
          "additionalProperties": false
        },
        "clientAccessPage": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "names": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "refreshSeconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "edge"
      ],
      "additionalProperties": false
    },
