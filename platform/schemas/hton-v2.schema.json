        "defaults": {
          "type": "object",
          "properties": {
            "protocolProfiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "egressFamily": {
              "enum": [
                "ipv4",
                "ipv6"
